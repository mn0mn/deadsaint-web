# Backend/commerce provider is TBD. Once chosen, this file documents
# what env vars the app expects. Copy to .env.local and fill in.

# --- If you go headless Shopify (Storefront API) ---
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# --- If you go with a custom backend / DB ---
# DATABASE_URL=
# NEXT_PUBLIC_API_BASE_URL=

# --- Payments (Stripe example) ---
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
